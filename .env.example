# Copy to .env and adjust. .env is git-ignored.
#   cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────
# PostGIS image, not plain postgres: the Destination Service needs the
# postgis extension for proximity queries. Same PG major version (16),
# so the existing data directory keeps working.
POSTGRES_IMAGE=postgis/postgis:16-3.4
POSTGRES_USER=explorelk
POSTGRES_PASSWORD=explorelk
POSTGRES_DB=explorelk_auth

# ── Auth service datasource (used when running the app locally) ─
AUTH_DB_URL=jdbc:postgresql://localhost:5433/explorelk_auth
AUTH_DB_USERNAME=explorelk
AUTH_DB_PASSWORD=explorelk

# ── Destination service datasource ────────────────────────────
DESTINATION_DB_URL=jdbc:postgresql://localhost:5433/explorelk_destination
DESTINATION_DB_USERNAME=explorelk
DESTINATION_DB_PASSWORD=explorelk

# The database name the compose container connects to. The URL above is for a
# destination-service run on the host; the container builds its own JDBC URL
# from this, because inside the network the host is `postgres` and the port 5432.
DESTINATION_DB_NAME=explorelk_destination

# Which profile the containerised destination-service starts in. `dev` loads the
# seed catalog and serves /swagger-ui.html; `prod` does neither.
DESTINATION_PROFILE=dev

# How the destination-service CONTAINER reaches the Auth Service. The AUTH_JWKS_URI
# above is the host-side address; a container cannot use localhost for it, so the
# default reaches back out to the host. Once auth-service is containerised here
# too, this becomes http://auth-service:8081/.well-known/jwks.json.
AUTH_JWKS_URI_INTERNAL=http://host.docker.internal:8081/.well-known/jwks.json

# Where the Destination Service fetches the Auth Service public key.
# Verification is local after the first fetch — Auth may then be down.
AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json

# The `iss` claim. Both services read it: auth-service signs it in, and every
# other service refuses a token that does not carry it — so a token minted by a
# dev Auth Service cannot be replayed against production.
JWT_ISSUER=explorelk-auth

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# The single topic every catalog event lands on. Consumers subscribe once and
# filter on eventType rather than tracking one topic name per verb.
KAFKA_CATALOG_TOPIC=explorelk.destination.events

# false runs the catalog with no broker at all: the outbox rows are still
# written, they simply are not drained until this is switched back on.
EVENTS_ENABLED=true

# ── CORS ──────────────────────────────────────────────────────
# Explicit origins, never a wildcard. Read by every service.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Mail (MailHog) ────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025

# ── SUPER_ADMIN bootstrap (Step 10) ───────────────────────────
SUPER_ADMIN_EMAIL=superadmin@explorelk.local
SUPER_ADMIN_PASSWORD=ChangeMe_123
