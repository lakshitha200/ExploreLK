<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.explorelk</groupId>
    <artifactId>destination-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>destination-service</name>
    <description>ExploreLK Destination Service — destinations, attractions, categories</description>

    <properties>
        <!-- Matches auth-service. Boot 4's baseline, and an LTS. -->
        <java.version>17</java.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <!--
            springdoc 3.x is the Spring Boot 4 line. The 2.x releases are built
            against Boot 3 and fail at startup here on the Spring Framework 7
            handler-mapping APIs.
        -->
        <springdoc.version>3.1.0</springdoc.version>
    </properties>

    <!--
        Spring Boot's parent does not manage Testcontainers versions, so the BOM
        pins them here. Without it the three module dependencies below fail the
        build at POM-parse time with "version is missing" — before any code is
        even read.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Persistence.

            Note what is NOT here: hibernate-spatial. The PostGIS `geog` column is
            GENERATED by the database from latitude/longitude and is never mapped by
            an entity, so no JTS types and no spatial dialect are needed. Proximity
            is one native query; everything else is plain JPA. See docs §6.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Migrations. Three artifacts are needed, and missing any one fails silently
            or at runtime rather than at build time:

            1. spring-boot-flyway  — Spring Boot 4 split autoconfiguration into
               per-technology modules. Without this, flyway-core is on the classpath
               but nothing ever runs it, and Hibernate meets an empty schema.
            2. flyway-core         — Flyway itself.
            3. flyway-database-postgresql — Flyway 10+ moved per-database support
               into separate modules.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
            Security: verify only.

            This service never holds a signing key and never mints a token. It
            fetches the Auth Service's public key from /.well-known/jwks.json,
            caches it, and checks signatures locally — so authorization costs no
            network call per request and survives the Auth Service being down.
            See SecurityConfig.

            The starter pulls in spring-security-oauth2-jose transitively, which is
            what does the RSA verification; it is not declared directly because
            nothing here signs anything.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Cache. Spring's cache abstraction over Redis: no hand-written
            RedisTemplate calls in service code. Redis holds only derived data
            here, so losing it costs latency and nothing else — see CacheConfig.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
            Lettuce connection pooling. NOT pulled in by the starter: without it
            `spring.data.redis.lettuce.pool.enabled: true` fails at startup with
            NoClassDefFoundError on GenericObjectPoolConfig, which reads as a
            Spring bug and is really a missing optional dependency.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!--
            Messaging. Kafka is NOT on the read path: browsing, searching and
            proximity are plain REST. Events exist only so other services learn
            the catalog changed underneath them, which is why a broker outage
            degrades nothing here — the outbox keeps accepting events into
            Postgres and drains when Kafka returns.
        -->
        <!--
            The STARTER, not spring-kafka on its own. Boot 4 moved every
            auto-configuration out of the monolithic spring-boot-autoconfigure
            jar and into per-technology modules, exactly as it did for Flyway
            above: with only spring-kafka present the library is on the
            classpath but nothing configures it, and the app dies at startup on
            "No qualifying bean of type KafkaTemplate<String, String>" — which
            reads as a generics problem and is really a missing module.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!--
            API documentation. Generated from the controllers and their DTOs, so
            it cannot drift from the code the way a hand-written document does.
            Switched OFF by default in application.yml and turned on only by the
            dev profile: a public schema of every admin endpoint is free
            reconnaissance, and there is no reason to serve it in production.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Health / metrics -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Boilerplate reduction -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            MockMvc. Boot 4 split the web test slices out of
            spring-boot-starter-test into per-stack modules, so
            @AutoConfigureMockMvc is no longer on the classpath by default and
            its package moved to org.springframework.boot.webmvc.test.
            Without this the test sources do not compile at all.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Integration tests run against real Postgres and Redis, never an
            in-memory substitute. H2 has no PostGIS, no JSONB and no trigram
            index, so a suite built on it would pass while the three things this
            service actually depends on went untested.

            The Postgres image MUST be the PostGIS one, or every spatial test
            fails on the first line of V1__init.sql at CREATE EXTENSION.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Polling for an event that arrives on a scheduler, without Thread.sleep. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                Unit tests run in `mvn test`; the *IT integration tests run in
                `mvn verify`, through failsafe. The split matters because the IT
                suite needs Docker: a developer without it running can still get
                fast feedback from the unit tests instead of a wall of container
                errors.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
