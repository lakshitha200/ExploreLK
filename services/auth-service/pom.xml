<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.explorelk</groupId>
    <artifactId>auth-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>auth-service</name>
    <description>ExploreLK Auth Service — identity, authentication, roles</description>

    <properties>
        <java.version>17</java.version>
        <springdoc.version>3.1.0</springdoc.version>
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <!--
        Spring Boot's parent does not manage Testcontainers versions, so the BOM
        pins them here. Without it the module dependencies below fail at
        POM-parse time with "version is missing", before any code is read.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Migrations. Three artifacts are needed, and missing any one fails silently
            or at runtime rather than at build time:

            1. spring-boot-flyway  — Spring Boot 4 split autoconfiguration into
               per-technology modules. Without this, flyway-core is on the classpath
               but nothing ever runs it, and Hibernate meets an empty schema.
               (In Boot 3 this lived inside spring-boot-autoconfigure.)
            2. flyway-core         — Flyway itself.
            3. flyway-database-postgresql — Flyway 10+ moved per-database support
               into separate modules.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Security filter chain + password hashing (Steps 3 and 5).
            spring-security-crypto (BCrypt) arrives transitively with the starter.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            Consumes the JWTs this service mints (Step 5).
            Every other ExploreLK service depends on this same starter, pointed at
            our /.well-known/jwks.json — the difference is they never hold the
            private key. Using it here too means one JWT implementation, not two.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
            Rate-limit counters, brute-force lockout and the access-token denylist
            (Steps 6 and 9). Never the source of truth — safe to wipe.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            Verification and password-reset email (Step 7), sent to MailHog locally.
            Step 8 moves sending to the Notification Service via Kafka; the
            EmailSender interface exists so that swap does not reach the callers.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!--
            JWT signing and the JWKS document (Step 4).

            This is a plain library — it brings Nimbus JOSE in without switching on
            any filter chain, which stays a Step 5 decision. Depending on it rather
            than com.nimbusds:nimbus-jose-jwt directly keeps the version managed:
            Spring Boot 4 pins Nimbus through the Spring Security BOM, not on its own,
            so declaring the Nimbus artifact here would demand a hardcoded version.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!--
            Messaging. The STARTER, not spring-kafka on its own: Boot 4 moved
            every auto-configuration into a per-technology module, exactly as it
            did for Flyway above. With only spring-kafka the library is on the
            classpath but nothing configures it, and the app dies at startup on
            "No qualifying bean of type KafkaTemplate<String, String>" — which
            reads as a generics problem and is really a missing module.

            Kafka is not on the request path. A broker outage costs nothing here:
            the outbox keeps accepting events into Postgres and drains when Kafka
            returns.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!--
            API documentation, generated from the controllers so it cannot drift
            from them. Switched OFF by default in application.yml and enabled
            only by the dev profile: a public schema of the whole auth surface is
            free reconnaissance. springdoc 3.x is the Spring Boot 4 line — the
            2.x releases are built against Boot 3 and fail at startup here.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Health / metrics -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Boilerplate reduction -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            MockMvc. Boot 4 split the web test slices out of
            spring-boot-starter-test into per-stack modules, so
            @AutoConfigureMockMvc is neither on the classpath nor in its old
            package. Without this the test sources do not compile at all.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Integration tests run against real Postgres, Redis and (for one test)
            Kafka, never an in-memory substitute. H2 has no partial index, no
            JSONB and no functional unique index, so a suite built on it would
            pass while the three things this service depends on went untested.

            Testcontainers must be 1.21+: Docker Desktop on Windows answers the
            legacy docker_engine pipe with an empty 400, and only 1.21 falls back
            to reading the active docker context.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Polling for an event that arrives on a scheduler, without Thread.sleep. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                Unit tests run in `mvn test`; the *IT integration tests run in
                `mvn verify`, through failsafe. The split matters because the IT
                suite needs Docker: a developer without it running can still get
                fast feedback from the unit tests instead of a wall of container
                errors.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
